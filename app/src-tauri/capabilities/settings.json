{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-capability",
  "description": "Local settings window (plugin toggles + options). Only the local page has access; no remote origin is granted.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-config",
    "allow-set-config",
    "allow-set-plugin-config",
    "allow-get-path",
    "allow-get-plugin-manifest",
    "allow-reload-player"
  ]
}
